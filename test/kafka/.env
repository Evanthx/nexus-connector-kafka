# Settings for the local Kafka in docker-compose.yml. docker compose reads the credentials to
# create the SCRAM user; the streamer and the nexusworker read everything here once loaded with
# `set -a; source test/kafka/.env; set +a`.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=events
KAFKA_USERNAME=connector
KAFKA_PASSWORD=connector-secret
