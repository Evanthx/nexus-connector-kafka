# Settings for the local Kafka in docker-compose.yml. docker compose reads the credentials to
# create the SCRAM user; the Inbound Connector and the Outbound Connector read everything here once
# loaded with `set -a; source test/kafka/.env; set +a`, from the repository root. The Inbound
# Connector streams both topics (routes.json); the Outbound Connector may write to both.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPICS=customers,orders
INBOUND_CONFIG_FILE=test/kafka/routes.json
KAFKA_USERNAME=connector
KAFKA_PASSWORD=connector-secret
